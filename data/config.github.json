{
  "version": "1.0",
  "ai": {
    "provider": "anthropic",
    "model": "claude-haiku-4-5-20251001",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 30,
      "min_score": 150
    },
    "rss": [
      {
        "name": "BBC World News",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "MoneyDJ 財經新聞",
        "url": "https://www.moneydj.com/kmdj/rss/newsrss.aspx?index1=1",
        "enabled": true,
        "category": "finance-tw"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 5
    }
  },
  "filtering": {
    "ai_score_threshold": 3.0,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "platform": "generic",
    "layout": "markdown",
    "languages": ["zh"],
    "request_body": {
      "content": "**#{message_title}**\n#{summary}"
    },
    "headers": ""
  }
}
